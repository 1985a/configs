# From chatpgt, move files > Dont work
function movefiles() {
  # Check if both source and destination directories are provided as arguments
  if [ "$#" -ne 2 ]; then
    echo "Usage: movefiles <source_directory> <destination_directory>"
    return 1
  fi

  source_dir="$1"
  destination_dir="$2"

  # Move all files from source to destination
  find "$source_dir" -type f -print0 | xargs -0 -r mv -t "$destination_dir"
}


