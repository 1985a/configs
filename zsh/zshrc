# Obtener las ultimas de archlinux, si hay un paquete roto o necesita intervencion manual
#
# La caché la escribe ~/.scripts/scripts/archnews-check.sh (temporizador systemd
# archnews-check.timer). Abrir la terminal ya no hace peticiones de red: solo lee
# la caché y, si tiene más de un día, la refresca en segundo plano.
function show_arch_latest_important_news() {
  local cache_file="${XDG_CACHE_HOME:-$HOME/.cache}/archnews-latest.txt"
  local checker="$HOME/.scripts/scripts/archnews-check.sh"
  [[ -r "$cache_file" ]] && cat "$cache_file"
  if [[ -x "$checker" && ( ! -f "$cache_file" || -n $(find "$cache_file" -mmin +1440 2>/dev/null) ) ]]; then
    "$checker" >/dev/null 2>&1 &!
  fi
}
