codebin() {
  emulate -L zsh

  # ===== CONFIG =====
  # la clave va en ~/.config/zsh/local.zsh:  export CODEBIN_KEY="..."
  local CODEBIN_KEY="${CODEBIN_KEY:-}"
  # =======================================

  command -v curl >/dev/null 2>&1 || { echo "ERROR: falta curl" >&2; return 127; }
  command -v python3 >/dev/null 2>&1 || { echo "ERROR: falta python3" >&2; return 127; }

  local base="https://www.codebin.cc"
  local upload_ep="${base}/api/v1/uploadPaste"
  local all_ep="${base}/api/v1/getAllPastes"

  local lang="shell"
  local title=""
  local desc=""
  local expiry="never"   # tu backend aceptó "never"
  local pass=""
  local list=0

  while getopts "l:t:d:e:p:Lh" opt; do
    case "$opt" in
      l) lang="$OPTARG" ;;
      t) title="$OPTARG" ;;
      d) desc="$OPTARG" ;;
      e) expiry="$OPTARG" ;;
      p) pass="$OPTARG" ;;
      L) list=1 ;;
      h)
        cat <<'EOF'
Uso:
  comando | codebin [-l lenguaje] [-t titulo] [-d descripcion] [-e expiracion] [-p password]
  codebin archivo

Ejemplos (zsh):
  cat pci_latency.sh | codebin -t "pci_latency.sh" -l shell
  codebin pci_latency.sh -t "pci_latency.sh" -l shell
  DEBUG=1 codebin -t "prueba" -l shell <<<"hola"
EOF
        return 0
        ;;
      *) echo "Opción inválida" >&2; return 2 ;;
    esac
  done
  shift $((OPTIND - 1))

  if [[ -z "$CODEBIN_KEY" || "$CODEBIN_KEY" == "PEGA_TU_API_KEY_AQUI" ]]; then
    echo "ERROR: define CODEBIN_KEY en ~/.config/zsh/local.zsh" >&2
    return 2
  fi

  # (Opcional) -L: solo prueba que tienes acceso a getAllPastes
  if [[ $list -eq 1 ]]; then
    curl -sS -H "Authorization: ${CODEBIN_KEY}" "$all_ep" | head
    return 0
  fi

  # Leer contenido (stdin o archivo)
  local content="" src_name="stdin"
  if [[ -t 0 ]]; then
    if [[ -n "${1:-}" ]]; then
      src_name="${1:t}"
      content="$(cat -- "$1")" || return 1
    else
      echo "ERROR: no recibí stdin ni archivo. Ej: dmesg | codebin  o  codebin archivo.txt" >&2
      return 2
    fi
  else
    content="$(cat)" || return 1
  fi

  [[ -n "$title" ]] || title="$src_name"
  [[ -n "$desc"  ]] || desc="Uploaded from terminal"

  # Payload JSON
  local payload
  payload="$(
    CB_LANGUAGE="$lang" CB_TITLE="$title" CB_DESC="$desc" CB_EXP="$expiry" CB_PASS="$pass" CB_CODE="$content" \
    python3 - <<'PY'
import json, os
data = {
  "language": os.environ.get("CB_LANGUAGE","shell"),
  "title": os.environ.get("CB_TITLE","stdin") or "stdin",
  "description": os.environ.get("CB_DESC","Uploaded from terminal") or "Uploaded from terminal",
  "expiration": os.environ.get("CB_EXP","never") or "never",
  "password": os.environ.get("CB_PASS",""),
  "code": os.environ.get("CB_CODE",""),
}
print(json.dumps(data, ensure_ascii=False))
PY
  )" || return 1

  # POST capturando HEADERS + BODY
  local hdr body
  hdr="$(mktemp)" || return 1
  body="$(mktemp)" || { rm -f "$hdr"; return 1; }

  curl -sS -D "$hdr" -o "$body" -X POST "$upload_ep" \
    -H "Authorization: ${CODEBIN_KEY}" \
    -H "Content-Type: application/json" \
    --data-binary "$payload" || { rm -f "$hdr" "$body"; return 1; }

  local resp
  resp="$(cat "$body")"

  if [[ "${DEBUG:-0}" == "1" ]]; then
    echo "---- payload ----" >&2
    echo "$payload" >&2
    echo "---- headers ----" >&2
    cat "$hdr" >&2
    echo "---- body ----" >&2
    echo "$resp" >&2
    echo "-----------------" >&2
  fi

  # 1) Intentar extraer URL/ID del BODY
  local url id
  url="$(python3 - <<'PY' "$resp" 2>/dev/null || true
import json, re, sys
s=sys.argv[1]
try:
  j=json.loads(s)
  if isinstance(j,dict):
    for k in ("url","link","pasteUrl","paste_url"):
      v=j.get(k)
      if isinstance(v,str) and v.startswith("http"):
        print(v); raise SystemExit
    for k in ("id","slug","key","pasteId","paste_id"):
      v=j.get(k)
      if isinstance(v,str) and v.strip():
        print("https://www.codebin.cc/" + v.strip()); raise SystemExit
except Exception:
  pass
m=re.search(r'https?://(?:www\.)?codebin\.cc/\S+', s)
if m: print(m.group(0))
PY
)"
  if [[ -n "$url" ]]; then
    rm -f "$hdr" "$body"
    echo "$url"
    return 0
  fi

  # 2) Intentar extraer ID desde HEADERS (Location / X-Paste-Id / etc.)
  id="$(
    awk 'BEGIN{IGNORECASE=1}
         /^location:/{gsub(/\r/,""); print $0}
         /^x-paste-id:/{gsub(/\r/,""); print $0}
         /^x-id:/{gsub(/\r/,""); print $0}' "$hdr" \
    | head -n 1 \
    | sed -E 's/^[^:]+:[[:space:]]*//; s#https?://[^/]+/##; s#[[:space:]]+$##'
  )"

  if [[ -n "$id" ]]; then
    rm -f "$hdr" "$body"
    echo "https://www.codebin.cc/$id"
    return 0
  fi

  # 3) Si el body dice success pero sin link, consultar getAllPastes y agarrar el más reciente
  local all
  all="$(curl -sS -H "Authorization: ${CODEBIN_KEY}" "$all_ep")"

  id="$(python3 - <<'PY' "$all" 2>/dev/null || true
import json, sys, datetime

raw=sys.argv[1]
try:
  j=json.loads(raw)
except Exception:
  print(""); raise SystemExit

# recolectar dicts que tengan posibles ids
cands=[]
def walk(x):
  if isinstance(x,list):
    for i in x: walk(i)
  elif isinstance(x,dict):
    # si parece un "paste" (tiene id/slug/key)
    keys=("id","slug","key","pasteId","paste_id")
    if any(isinstance(x.get(k), (str,int)) for k in keys):
      cands.append(x)
    for v in x.values(): walk(v)
walk(j)

def get_id(d):
  for k in ("id","slug","key","pasteId","paste_id"):
    v=d.get(k)
    if isinstance(v,(str,int)) and str(v).strip():
      return str(v).strip()
  return None

def get_time(d):
  for k in ("createdAt","created_at","created","date","timestamp"):
    v=d.get(k)
    if isinstance(v,(int,float)):
      return float(v)
    if isinstance(v,str) and v.strip():
      s=v.strip()
      # intentar iso8601 simple
      try:
        dt=datetime.datetime.fromisoformat(s.replace("Z","+00:00"))
        return dt.timestamp()
      except Exception:
        pass
  return 0.0

# elegir el candidato con mayor timestamp; si no hay timestamps, el primero
best=None
best_t=-1
for d in cands:
  pid=get_id(d)
  if not pid: 
    continue
  t=get_time(d)
  if t>best_t:
    best_t=t
    best=pid

print(best or "")
PY
)"

  rm -f "$hdr" "$body"

  if [[ -n "$id" ]]; then
    echo "https://www.codebin.cc/$id"
    return 0
  fi

  echo "ERROR: Subió (o el API dijo success) pero no pude obtener ID/URL." >&2
  echo "Sugerencia: en el navegador, abre Network y copia como cURL la petición real a /api/v1/uploadPaste para ver qué devuelve." >&2
  return 1
}

# Matiene el dbus correcto en la terminal
if [ -n "$XDG_RUNTIME_DIR" ] && [ -S "$XDG_RUNTIME_DIR/bus" ]; then
    export DBUS_SESSION_BUS_ADDRESS="unix:path=$XDG_RUNTIME_DIR/bus"
