lastdump_gdb() {
    # Uso:
    #   lastdump_gdb spcplay-pw
    #   lastdump_gdb spc2wav
    #   lastdump_gdb test_initapu
    #
    # Opcional:
    #   lastdump_gdb spc2wav after_emuspc_ram_pointer_fix1

    local prog="$1"
    local tag="${2:-auto}"
    local list line pid exe base core out cwd

    if [ -z "$prog" ]; then
        echo "Uso:"
        echo "  lastdump_gdb spcplay-pw"
        echo "  lastdump_gdb spc2wav"
        echo "  lastdump_gdb test_initapu"
        return 1
    fi

    cwd="$(pwd)"

    list="$(
        coredumpctl list --no-pager --no-legend 2>/dev/null | tail -50
    )"

    if [ -z "$list" ]; then
        echo "ERROR: coredumpctl no devolvio coredumps."
        echo "Prueba:"
        echo "  coredumpctl list | tail -50"
        return 1
    fi

    line="$(
        printf '%s\n' "$list" \
        | grep -E "/${prog}$| ${prog}$" \
        | tail -n 1
    )"

    if [ -z "$line" ]; then
        echo "ERROR: No encontre coredump reciente para: $prog"
        echo
        echo "Ultimos 50 coredumps:"
        printf '%s\n' "$list"
        return 1
    fi

    pid="$(printf '%s\n' "$line" | awk '{print $5}')"
    exe="$(printf '%s\n' "$line" | awk '{print $NF}')"
    base="$(basename "$exe")"

    if [ -z "$pid" ] || [ -z "$exe" ]; then
        echo "ERROR: No pude extraer PID o ejecutable desde:"
        echo "$line"
        return 1
    fi

    if [ ! -x "$exe" ]; then
        echo "AVISO: El ejecutable original no existe o no es ejecutable:"
        echo "  $exe"
        echo "Intentando usar ./$base"
        exe="./$base"
    fi

    if [ ! -x "$exe" ]; then
        echo "ERROR: No existe ./$base o no es ejecutable."
        echo "Ejecuta esto desde el directorio donde esta el binario."
        return 1
    fi

    core="${cwd}/core.${tag}.${base}.${pid}"
    out="${cwd}/64bit_crash_${tag}_${base}_${pid}_gdb.txt"

    echo "Coredump elegido:"
    echo "  $line"
    echo
    echo "PID        : $pid"
    echo "Ejecutable: $exe"
    echo "Core       : $core"
    echo "Reporte    : $out"
    echo

    coredumpctl dump "$pid" -o "$core"
    if [ $? -ne 0 ]; then
        echo "ERROR: fallo coredumpctl dump."
        return 1
    fi

    if [ ! -s "$core" ]; then
        echo "ERROR: El core no se genero o esta vacio:"
        echo "  $core"
        return 1
    fi

    DEBUGINFOD_URLS="" gdb -nx -batch -q \
      -ex "set debuginfod enabled off" \
      -ex "file $exe" \
      -ex "core-file $core" \
      -ex "set pagination off" \
      -ex "bt full" \
      -ex "frame 0" \
      -ex "info registers" \
      -ex "x/180i \$pc-120" \
      -ex "x/180gx \$rsp-160" \
      -ex "info symbol \$pc" \
      -ex "info sharedlibrary" \
      -ex "quit" \
      > "$out" 2>&1

    if [ ! -f "$out" ]; then
        echo "ERROR: El archivo .txt no fue creado."
        return 1
    fi

    if [ ! -s "$out" ]; then
        echo "ERROR: El archivo .txt fue creado pero esta vacio:"
        echo "  $out"
        return 1
    fi

    echo "OK: archivos generados:"
    echo "  $core"
    echo "  $out"
    echo
    echo "Vista rapida del reporte:"
    head -40 "$out"
}


