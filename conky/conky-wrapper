#!/bin/sh
# Lanza conky como "status_command" de swaybar (protocolo JSON de i3bar).
# Referenciado desde la sección "bar" de ~/.config/i3/config.

# Cabecera: indica a la barra que hablamos JSON
echo '{"version":1}'
# Comienza el arreglo infinito
echo '['
# Primer elemento vacío, así cada línea de conky puede empezar con coma
echo '[],'

exec conky -c "$HOME/.conkyrc.json"
