--[[
Barra de estado de sway (swaybar) generada por conky en formato JSON.
La lanza ~/conky-wrapper desde la sección "bar" de ~/.config/i3/config.
Los scripts auxiliares viven en ~/.scripts/scripts/.

Ciudad del clima: escríbela en ~/.config/weather-location (no se sube al repo).
Si no existe, wttr.in usa la ubicación aproximada de tu IP.
]]

conky.config = {

background	= false,
out_to_console	= true,
out_to_x	= false,
update_interval	= 2,
total_run_times	= 0,
short_units	= true,
pad_percents	= 2,
override_utf8_locale 	= true,
times_in_seconds	= true,
};

conky.text = [[

# JSON for i3bar
[
# name of the active window
#{
#    "full_text": ${exec ~/.scripts/scripts/active-window.py}
#},


# PACMAN updates
{
"full_text": "  ${execpi 3600 checkupdates | wc -l}",
   "color":"\#B58900",
   "align": "left"
}, 
# Search for this on /sys/class/hwmon
 # TEMP Processors temp3 hwmon0 nvme disk
 {
  "full_text": "  ${execi 2 ~/.scripts/scripts/jsafe.sh ~/.scripts/scripts/conky_hwmon_auto.sh temps}°C ",
   "color":"\#B58900",
   "align": "left"
},

 # RPM Processors #fan2 processor fan6 harddrivers fan3 fan trasero fan6 nvme disk
{ 
  "full_text": "${execi 2 ~/.scripts/scripts/jsafe.sh ~/.scripts/scripts/conky_hwmon_auto.sh fans}  ",
  "color":"\#B58900",
  "align": "left"

},

{
  "full_text": "  ${execi 2 ~/.scripts/scripts/jsafe.sh ~/.scripts/scripts/conky_hwmon_auto.sh watts} ",
  "color":"\#B58900",
  "align": "left"
},

{
  "full_text": "  ${execi 2 ~/.scripts/scripts/jsafe.sh ~/.scripts/scripts/gpu_stats.sh} ",
  "color":"\#B58900",
  "align": "left"
},
### MPD CONKY
# Any UTF8 JSON error may be caused by some invalid character in title/filename song
# esta parte funciona jevi

#{ "full_text" : "  ",
#  "color" : "\#FF8300",
#  "separator" : false, "separator_block_width" : 2
#},

#{
# "full_text" : ${if_mpd_playing}"${scroll 40 2 ${mpd_artist 20} - ${mpd_title 20}}"${else}""${endif},
# "color" : "\#999999",
#  "min_width" : 200,
#  "separator" : false, "separator_block_width" : 2
#},

# Lo de arriba funciona jevi


{"full_text" :\
${if_mpd_playing}\
${if_match "${mpd_random}"=="On"}\
""\
${else}""\
${endif}\
${else}""${endif},
"separator":false,
"separator_block_width":3,
"color" : ${if_match "${mpd_random}"=="On"}\
"\#FF8300"\
${else} "\#999999"\
${endif}},
{ "full_text" :\
${if_mpd_playing}\
${if_match "${mpd_repeat}"=="On"}""\
${else} ""\
${endif}\
${else}""${endif},
"separator":false,
"separator_block_width":5,
"color" : ${if_match "${mpd_repeat}"=="On"}\
"\#FF8300"\
${else} "\#999999"\
${endif}},
{ "full_text": "${execi 2 ~/.scripts/scripts/mpd_scroll.sh}",

"separator":false,
"separator_block_width":8,
"color":"\#999999"},


####
     # red: si el cable está conectado se muestra el cable (aunque el wifi también lo esté);
     # si no, el wifi; si ninguno, "no connection". br0 es el puente que contiene a cable0.
      ${if_existing /sys/class/net/cable0/operstate up}
        {
          "full_text": "   ${downspeedf br0}KB   ${upspeedf br0}KB ",
          #"color":"\#A4ADD3"
	   "color":"\#8FBF3D"
        },
        {
          "full_text": "  cable",
          "color":"\#33CC99"
        },
      ${else}${if_existing /sys/class/net/wifi0/operstate up}
        {
          "full_text": "   ${downspeedf wifi0}KB   ${upspeedf wifi0}KB ",
	   "color":"\#8FBF3D"
        },
        {
          "full_text": "   ${execi 10 ~/.scripts/scripts/jsafe.sh ~/.scripts/scripts/wifi_ssid.sh wifi0}",
          "color":"\#33CC99"
        },
      ${else}
        {
          "full_text": "  no connection ",
          "color":"\#33CC99"
        },
      ${endif}${endif}
 
   # system volume
  {
    "full_text": " ${exec ~/.scripts/scripts/jsafe.sh ~/.scripts/scripts/volumelevel.sh}% ",
	  "color": ${if_empty ${exec ~/.scripts/scripts/ismute.sh | grep yes}}"\#D4F442"${else}"\#ffff00"${endif}
  },
  
  # date
  {
   "full_text": "  ${time %a %m/%d/%y} ",
   "color":"\#42dcf4"
 },
  # weather
  {
    "full_text" : " ${execi 600 ~/.scripts/scripts/jsafe.sh ~/.scripts/scripts/weather3.sh} ${execi 600 ~/.scripts/scripts/jsafe.sh ~/.scripts/scripts/weather_icons.sh}",
    "separator":true, "separator_block_width":8,
    "color":"\#eaffd1",
   "align": "left"
  },

  # time
  {
   "full_text": "  ${time %R} "
   ,
   "color":"\#ffffff"
  },
  # bluetooth
  {"full_text": "${execi 5 ~/.scripts/scripts/jsafe.sh ~/.scripts/scripts/bluetooth_battery_status.sh}" ,
  "color": "\#f4c242"
  }

],

]];
