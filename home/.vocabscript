#!/usr/bin/env bash
# Muestra una palabra en inglés al azar y su significado.
# Lo carga ~/.vocab (que define wordarray y meaningarray) al abrir la terminal.
# shellcheck disable=SC2154  # wordarray y meaningarray vienen de ~/.vocab

size=${#wordarray[@]}
(( size > 0 )) || return 0 2>/dev/null || exit 0

i=$(( RANDOM % size ))

YELLOW=$'\e[1;33m'
PURPLE=$'\e[0;35m'
NC=$'\e[0m'
bold=$(tput bold 2>/dev/null)

# los datos van como argumentos de printf y no dentro del formato:
# una palabra con "%" ya no puede romper la salida
printf '%sWord Of The Session: %s%s%s\n' "$bold" "$YELLOW" "${wordarray[i],,}" "$NC"
printf '%sMeaning            : %s%s%s\n\n' "$bold" "$PURPLE" "${meaningarray[i],,}" "$NC"
