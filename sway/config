set $mode_system System:   L :  | S :  | P :  | R :  | E :   
mode "$mode_system" {
    # i3lock-fancy e i3-msg son de X11; en sway: swaylock y swaymsg.
    # (antes la línea de suspender no cerraba las comillas y usaba $Lock sin definir)
    bindsym l exec --no-startup-id swaylock -f -c 000000, mode "default"
    bindsym s exec --no-startup-id swaylock -f -c 000000 && systemctl suspend, mode "default"
    bindsym p exec --no-startup-id systemctl poweroff -i, mode "default"
    bindsym r exec --no-startup-id systemctl reboot, mode "default"
    bindsym e exec --no-startup-id swaymsg exit, mode "default"
    # back to normal: Enter or Escape
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+Shift+Delete mode "$mode_system"
	
