#!/usr/bin/env bash
# Apaga los monitores tras un rato sin actividad (teclado/ratón) y los enciende
# al volver. Lo lanza ~/.config/i3/config con "exec_always": al recargar sway se
# reemplaza el swayidle anterior, así que nunca quedan dos.
#
#   sway-idle          arranca swayidle (lo que hace sway)
#   sway-idle off      lo llama swayidle al cumplirse el tiempo
#   sway-idle on       lo llama swayidle al volver la actividad
#
# Minutos de espera: variable SWAY_IDLE_MIN (por defecto 30).
#
# No se apagan:
#  - con una ventana en pantalla completa (regla inhibit_idle en sway/config),
#    ni con vídeo en mpv/navegador (ellos mismos lo impiden);
#  - mientras haya un juego abierto (lista JUEGOS más abajo: Steam, Lutris,
#    wine/Proton, RetroArch y los emuladores), aunque esté en ventana: el mando no cuenta como actividad para swayidle. Al cerrar el
#    juego se cuentan otra vez SWAY_IDLE_MIN minutos antes de apagar.
set -u

MIN="${SWAY_IDLE_MIN:-30}"
[[ "$MIN" =~ ^[1-9][0-9]*$ ]] || { echo "SWAY_IDLE_MIN no válido: $MIN" >&2; exit 2; }
ESPERA=$((MIN * 60))
PASO="${SWAY_IDLE_PASO:-60}"   # cada cuánto se mira si sigue el juego (s)
UID_NUM="$(id -u)"
PIDFILE="${XDG_RUNTIME_DIR:-/tmp}/sway-idle-off.pid"

# Programas que cuentan como "juego abierto". Es el nombre del proceso (lo que
# muestra "ps -o comm", máx. 15 letras), comparado entero. Para añadir uno:
# arrancarlo y mirar "ps -eo comm | sort -u".
JUEGOS=(
    retroarch dolphin-emu pcsx2-qt rpcs3 yuzu 'Ryujinx.*' snes9x-gtk bsnes ares
    'citra(-qt)?' azahar flycast 'mgba(-qt)?' Mesen
    gamescope   # Steam o lanzado a mano dentro de gamescope
    wineserver  # cualquier juego de Windows: Lutris, Heroic, Proton, wine suelto
    sm-nshvc ocarina runner   # Super Metroid, Ocarina (NX2navi), AM2R
)
JUEGOS_RE="$(IFS='|'; echo "${JUEGOS[*]}")"

# Programas que se reconocen por su línea de órdenes (anclada al inicio para no
# contar otros procesos que solo mencionen el texto).
JUEGOS_CMD=(
    '^[^ ]*reaper SteamLaunch AppId='   # cada juego de Steam
    '^[^ ]* [^ ]*/lutris-wrapper '      # juegos nativos de Lutris
    '^mono [^ ]*Mesen-S\.exe'          # Mesen-S (con mono)
)

hay_juego() {
    local re
    pgrep -u "$UID_NUM" -x -- "$JUEGOS_RE" >/dev/null && return 0
    for re in "${JUEGOS_CMD[@]}"; do
        pgrep -u "$UID_NUM" -f -- "$re" >/dev/null && return 0
    done
    return 1
}

# Termina un "off" que esté esperando a que se cierre un juego.
cancelar_espera() {
    local pid
    pid="$(cat "$PIDFILE" 2>/dev/null)" || return 0
    [[ "$pid" =~ ^[0-9]+$ ]] && kill "$pid" 2>/dev/null
    rm -f "$PIDFILE"
}

apagar() {
    cancelar_espera
    echo $$ > "$PIDFILE"
    trap 'rm -f "$PIDFILE"' EXIT

    local libre=0 hubo_juego=0
    while :; do
        if hay_juego; then
            hubo_juego=1 libre=0
        elif (( ! hubo_juego || libre >= ESPERA )); then
            break
        fi
        sleep "$PASO"
        (( hubo_juego )) && ! hay_juego && libre=$((libre + PASO))
    done
    swaymsg 'output * power off' >/dev/null
}

case "${1:-}" in
    off) apagar ;;
    on)
        cancelar_espera
        swaymsg 'output * power on' >/dev/null
        ;;
    '')
        command -v swayidle >/dev/null 2>&1 || { echo "falta swayidle" >&2; exit 1; }
        pkill -u "$UID_NUM" -x swayidle 2>/dev/null || true
        cancelar_espera
        # Sin -w: "off" puede quedarse esperando a que se cierre un juego y
        # swayidle no debe bloquearse por eso.
        self="$(readlink -f "$0")"
        exec swayidle \
            timeout "$ESPERA" "'$self' off" \
            resume "'$self' on"
        ;;
    *) echo "uso: ${0##*/} [on|off]" >&2; exit 2 ;;
esac
