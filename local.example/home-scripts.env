# Valores de tu red y tus equipos que usan algunos scripts de home/.
# Cópialo a ~/.config/home-scripts.env y rellénalo. NO lo subas al repositorio.
# Los scripts lo cargan solos si existe. Usa la forma VAR="${VAR:-valor}" para que una
# variable pasada a mano tenga prioridad sobre este archivo, p. ej.:
#   sudo BRIDGE_ADDR=192.168.1.250/24 ./bridge-win10.sh

# Puente para máquinas virtuales (bridge_qemu2.sh, puente-win10.sh, bridge_qemu-disable.sh, bridge-win10.sh)
BRIDGE_IFACE="${BRIDGE_IFACE:-cable0}"           # interfaz física
BRIDGE_NAME="${BRIDGE_NAME:-kvm_bridge}"
BRIDGE_PRIMARY_ADDR="${BRIDGE_PRIMARY_ADDR:-}"           # IP de la interfaz física, p. ej. 192.168.1.2/24
BRIDGE_ADDR="${BRIDGE_ADDR:-}"                   # IP del puente, p. ej. 192.168.1.10/24
BRIDGE_GW="${BRIDGE_GW:-}"                     # puerta de enlace, p. ej. 192.168.1.1

# Televisor Samsung con modo desarrollador (quitar_apps_tv.sh)
TV_ADDR="${TV_ADDR:-}"                       # p. ej. 192.168.1.50:26101

# Prueba de carga del stream de audio (test-mpd.sh)
STREAM_URL="${STREAM_URL:-}"                    # p. ej. https://radio.ejemplo.com/opus

# Imagen VHD a montar (mountimgVHD.sh)
VHD_IMAGE="${VHD_IMAGE:-}"                     # p. ej. $HOME/discoD.vhd
