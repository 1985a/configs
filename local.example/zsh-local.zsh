# Copia este archivo a ~/.config/zsh/local.zsh y rellena tus valores.
# ~/.zshrc lo carga al final. NO lo subas al repositorio.

# Clave de la API de codebin.cc (función "codebin")
export CODEBIN_KEY=""

# Red wifi de invitados (función "qrwifi")
export WIFI_GUEST_SSID=""
export WIFI_GUEST_PASS=""

# Coordenadas para el filtro de luz azul (función "filtroazul")
export WLSUNSET_LAT=""
export WLSUNSET_LON=""
