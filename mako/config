sort=-time
layer=overlay
background-color=#2e3440
width=300
height=110
border-size=2
border-color=#88c0d0
border-radius=15
icons=1
max-icon-size=160
default-timeout=10000
ignore-timeout=0
font=monospace 14
max-visible=1

[urgency=low]
border-color=#cccccc

[urgency=normal]
border-color=#d08770

[urgency=high]
border-color=#bf616a
default-timeout=50000

[urgency=critical]
default-timeout=60000

[category=mpd]
default-timeout=2000
group-by=category

# notificación de canción de ncmpcpp (~/.local/bin/ncmpcpp-notify.sh) con carátula
[app-name=ncmpcpp]
width=480
height=130
max-icon-size=96

[app-name=Zebamp]
width=560
height=170
max-icon-size=128
